# ---- Canvas instance ----
# Base URL of your Canvas (no trailing slash), e.g. https://canvas.instructure.com
CANVAS_BASE_URL=https://canvas.instructure.com

# Manual Canvas API token (Account/Settings -> New Access Token) used to read
# Modules. For a lite POC this is a single token; production would use per-user OAuth.
CANVAS_API_TOKEN=

# Optional: only used for local testing outside a real launch. In Canvas the
# course id comes from the LTI launch custom field ($Canvas.course.id).
CANVAS_COURSE_ID=

# ---- LTI 1.1 (XML config) ----
# You choose these two. Enter the SAME key/secret in Canvas when installing the
# app "By URL / Paste XML". Canvas signs the launch with the secret; we verify.
LTI_CONSUMER_KEY=study-agent
LTI_SHARED_SECRET=

# Random string used to sign the short-lived session cookie.
STATE_SECRET=

# ---- My Progress app (single source of truth for progress + health) ----
# The lovable student-greeting-hub Supabase project. The agent reads the SAME
# progress/health the student sees on screen via its edge functions
# (phase-config student_progress + canvas-dashboard). If either is unset, the agent
# runs "honest-blind" (says it can't read progress) rather than inventing numbers.
MYPROGRESS_URL=https://<project-ref>.supabase.co
MYPROGRESS_ANON_KEY=

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Cheap model for the per-message emotional triage (coach/status/distress/crisis).
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5

# ---- Advising deflection ----
# When the agent detects a student may leave the program (at_risk) or is in crisis, it
# stops coaching and hands off to advising. Shown as copyable text (no mailto).
# BACKLOG: real notification (Segment event -> HubSpot workflow -> task for contact owner
# with the conversation as payload). Until then this inbox is the actual path.
ADVISING_EMAIL=advising@springboard.com
