# ---- Canvas instance ----
# Base URL of your Canvas (no trailing slash), e.g. https://canvas.instructure.com
CANVAS_BASE_URL=https://canvas.instructure.com

# Manual Canvas API token (Account/Settings -> New Access Token) used to read
# Modules. For a lite POC this is a single token; production would use per-user OAuth.
CANVAS_API_TOKEN=

# Optional: only used for local testing outside a real launch. In Canvas the
# course id comes from the LTI launch custom field ($Canvas.course.id).
CANVAS_COURSE_ID=

# ---- LTI 1.1 (XML config) ----
# You choose these two. Enter the SAME key/secret in Canvas when installing the
# app "By URL / Paste XML". Canvas signs the launch with the secret; we verify.
LTI_CONSUMER_KEY=study-agent
LTI_SHARED_SECRET=

# Random string used to sign the short-lived session cookie.
STATE_SECRET=

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
